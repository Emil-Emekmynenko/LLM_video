MEDIA_FACTORY_EXPORT_CHUNK_SIZE=1048576
MEDIA_FACTORY_DELIVERY_PROVIDER=filesystem
MEDIA_FACTORY_DELIVERY_FILESYSTEM_ROOT=./data/deliveries
MEDIA_FACTORY_DELIVERY_PART_SIZE=33554432
