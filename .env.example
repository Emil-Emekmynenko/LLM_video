MEDIA_FACTORY_FFPROBE_BIN=ffprobe
MEDIA_FACTORY_FFMPEG_BIN=ffmpeg
MEDIA_FACTORY_DATABASE_URL=sqlite:///./data/media_factory.sqlite3
MEDIA_FACTORY_AUTO_CREATE_SCHEMA=true
MEDIA_FACTORY_REDIS_URL=redis://localhost:6379/0
MEDIA_FACTORY_QUEUE_NAME=media-tasks
MEDIA_FACTORY_PROXY_DIR=./data/proxies
MEDIA_FACTORY_CLIP_DIR=./data/clips
MEDIA_FACTORY_MAX_CLIP_DURATION=15
MEDIA_FACTORY_CLIP_OVERLAP=2
MEDIA_FACTORY_VLM_PROVIDER=fake
MEDIA_FACTORY_ALLOW_FAKE_VLM=true
MEDIA_FACTORY_QWEN_BASE_URL=http://localhost:8001/v1
