MEDIA_FACTORY_QWEN_TIMEOUT_SECONDS=600
MEDIA_FACTORY_QWEN_MAX_RETRIES=2
MEDIA_FACTORY_QWEN_TEMPERATURE=0.1
MEDIA_FACTORY_QWEN_MAX_TOKENS=2048
MEDIA_FACTORY_NARRATION_DIR=./data/narration
MEDIA_FACTORY_TTS_PROVIDER=fake
MEDIA_FACTORY_ALLOW_FAKE_TTS=true
MEDIA_FACTORY_PIPER_BIN=piper
MEDIA_FACTORY_PIPER_MODEL_PATH=
MEDIA_FACTORY_PIPER_MODEL_REVISION=unversioned
MEDIA_FACTORY_PIPER_SPEAKER=
MEDIA_FACTORY_PIPER_LENGTH_SCALE=1.0
MEDIA_FACTORY_ALLOW_ADDITIONAL_AUDIO=false
MEDIA_FACTORY_MASTER_DIR=./data/masters
MEDIA_FACTORY_MASTER_CONTAINER_EXTENSION=mp4
MEDIA_FACTORY_MASTER_DURATION_TOLERANCE=0.1
MEDIA_FACTORY_TRANSCRIPT_DURATION_TOLERANCE=0.5
MEDIA_FACTORY_ASR_PROVIDER=fake
MEDIA_FACTORY_ALLOW_FAKE_ASR=true
MEDIA_FACTORY_FASTER_WHISPER_MODEL=small
MEDIA_FACTORY_FASTER_WHISPER_MODEL_REVISION=unversioned
MEDIA_FACTORY_FASTER_WHISPER_DEVICE=auto
MEDIA_FACTORY_FASTER_WHISPER_COMPUTE_TYPE=int8
MEDIA_FACTORY_FASTER_WHISPER_LANGUAGE=
MEDIA_FACTORY_FASTER_WHISPER_BEAM_SIZE=5
MEDIA_FACTORY_FASTER_WHISPER_VAD_FILTER=true
MEDIA_FACTORY_PACKAGE_DIR=./data/packages
MEDIA_FACTORY_DEFAULT_CUSTOMER=internal
MEDIA_FACTORY_DEFAULT_CUSTOMER_SCHEMA_VERSION=1.0
